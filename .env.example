# ── Database ──────────────────────────────────────────────────────────────────
# Supabase → Project Settings → Database → Connection string → "Transaction pooler"
# (use the pooler URL on port 6543, NOT the direct connection)
DATABASE_URI=postgresql://postgres.YOUR_PROJECT_REF:YOUR_DB_PASSWORD@aws-0-eu-central-1.pooler.supabase.com:6543/postgres

# For local development with the bundled PGlite dev DB (pnpm dev:db), use instead:
# DATABASE_URI=postgresql://postgres:postgres@127.0.0.1:5432/geopolitika
# DATABASE_POOL_MAX=5

# ── Payload ───────────────────────────────────────────────────────────────────
# Any long random string; generate with: openssl rand -hex 32
PAYLOAD_SECRET=YOUR_SECRET_HERE

# Public URL of the site (no trailing slash). http://localhost:3000 in dev.
NEXT_PUBLIC_SERVER_URL=http://localhost:3000

# ── Supabase Storage (S3-compatible) — media uploads ─────────────────────────
# Supabase → Storage → create a PUBLIC bucket (e.g. "media"),
# then Storage → Settings → "S3 Connection" for endpoint/region,
# and "New access key" for the key pair.
# Leave these empty in local dev to store uploads on local disk instead.
S3_BUCKET=media
S3_ENDPOINT=https://YOUR_PROJECT_REF.storage.supabase.co/storage/v1/s3
S3_REGION=eu-central-1
S3_ACCESS_KEY_ID=YOUR_S3_ACCESS_KEY_ID
S3_SECRET_ACCESS_KEY=YOUR_S3_SECRET_ACCESS_KEY
